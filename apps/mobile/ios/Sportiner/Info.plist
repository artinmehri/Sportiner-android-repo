<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <key>CFBundleAllowMixedLocalizations</key>
    <true/>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>Sportiner</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleURLTypes</key>
    <array>
      <dict>
        <key>CFBundleURLSchemes</key>
        <array>
          <string>sportiner</string>
          <string>com.sportiner.app</string>
        </array>
      </dict>
      <dict>
        <key>CFBundleURLSchemes</key>
        <array>
          <string>com.googleusercontent.apps.939148334598-8al463kq6ov8gr46v932pdl98vnjd3r7</string>
        </array>
      </dict>
    </array>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>12.0</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>NSAppTransportSecurity</key>
    <dict>
      <key>NSAllowsArbitraryLoads</key>
      <false/>
      <key>NSAllowsLocalNetworking</key>
      <true/>
    </dict>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>Allow Sportiner to create, update, and delete calendar events so it can automatically schedule, adjust, and manage your games, training sessions, and match times.</string>
    <key>NSCalendarsUsageDescription</key>
    <string>Allow Sportiner to read your calendar so it can display your upcoming sports games, practices, and scheduled events inside the app.</string>
    <key>NSCameraUsageDescription</key>
    <string>Sportiner uses your camera so you can take photos to use as your profile picture and share images in game posts and chat with other players.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Sportiner uses your location to suggest nearby tennis courts and help you find games in your area, even when the app is in the background.</string>
    <key>NSLocationAlwaysUsageDescription</key>
    <string>Sportiner uses your location to suggest nearby tennis courts and help you find games in your area, even when the app is in the background.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Sportiner uses your location to suggest nearby tennis courts and help you find sports games near you.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Sportiner needs permission to save photos so you can save images shared in game chats and profile pictures to your photo library.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Sportiner uses your photo library so you can upload a profile photo and share photos in game posts and chat.</string>
    <key>NSRemindersFullAccessUsageDescription</key>
    <string>Allow Sportiner to create, modify, and remove reminders so it can automatically set alerts for games, practices, and event notifications.</string>
    <key>NSRemindersUsageDescription</key>
    <string>Allow Sportiner to read your reminders so it can show your existing sports-related tasks and upcoming alerts within the app.</string>
    <key>NSUserActivityTypes</key>
    <array>
      <string>$(PRODUCT_BUNDLE_IDENTIFIER).expo.index_route</string>
    </array>
    <key>RCTNewArchEnabled</key>
    <true/>
    <key>UILaunchStoryboardName</key>
    <string>SplashScreen</string>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
      <string>arm64</string>
    </array>
    <key>UIRequiresFullScreen</key>
    <true/>
    <key>UIStatusBarStyle</key>
    <string>UIStatusBarStyleDefault</string>
    <key>UISupportedInterfaceOrientations</key>
    <array>
      <string>UIInterfaceOrientationPortrait</string>
      <string>UIInterfaceOrientationPortraitUpsideDown</string>
    </array>
    <key>UIUserInterfaceStyle</key>
    <string>Automatic</string>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>
  </dict>
