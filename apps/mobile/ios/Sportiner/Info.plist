	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sportiner</string>
				<string>com.sportiner.app</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.939148334598-8al463kq6ov8gr46v932pdl98vnjd3r7</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>12.0</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Sportiner uses calendar access only when you choose to add a tennis game to your calendar.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Sportiner uses calendar access only when you choose to add a tennis game to your calendar.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Sportiner uses your location only when you choose nearby discovery to show nearby tennis games and courts. Sportiner does not track your location in the background.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Sportiner uses your location to show nearby tennis games and courts when you choose to use nearby discovery.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Allow Sportiner to access photos you choose for your profile or to share with other players in private and group chats.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Sportiner uses reminders access only when you choose to save a reminder for a tennis game.</string>
	<key>NSRemindersUsageDescription</key>
	<string>Sportiner uses reminders access only when you choose to save a reminder for a tennis game.</string>
	<key>NSUserNotificationsUsageDescription</key>
	<string>Sportiner sends you notifications about nearby tennis games, new chat messages, and when someone joins your game.</string>
	<key>NSUserActivityTypes</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).expo.index_route</string>
	</array>
	<key>RCTNewArchEnabled</key>
	<true/>
