{
  "expo": {
    "name": "Sportiner",
    "slug": "sportiner",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sportiner",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.sportiner.app",
      "usesAppleSignIn": true,
      "buildNumber": "67",
      "simulator": {
        "device": "iPhone 17 Pro"
      },
      "supportsTablet": false,
      "requireFullScreen": true,
      "appleTeamId": "6YMBF7XTQC",
      "associatedDomains": [
        "applinks:sportiner.com"
      ],
      "infoPlist": {
        "UIRequiresFullScreen": true,
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Sportiner uses your location only when you choose nearby discovery to show nearby tennis games and courts. Sportiner does not track your location in the background.",
        "NSLocationWhenInUseUsageDescription": "Sportiner uses your location to show nearby tennis games and courts when you choose to use nearby discovery.",
        "NSUserNotificationsUsageDescription": "Sportiner sends you notifications about nearby tennis games, new chat messages, and when someone joins your game.",
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sportiner.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#19E675",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Sportiner uses your location only when you choose nearby discovery to show nearby tennis games and courts. Sportiner does not track your location in the background.",
          "locationAlwaysPermission": false,
          "locationWhenInUsePermission": "Sportiner uses your location to show nearby tennis games and courts when you choose to use nearby discovery."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Sportiner uses calendar access only when you choose to add a tennis game to your calendar.",
          "remindersPermission": "Sportiner uses reminders access only when you choose to save a reminder for a tennis game."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sportiner uses your photo library when you choose a profile photo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Sportiner uses your photo library when you choose a profile photo.",
          "savePhotosPermission": false
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.939148334598-8al463kq6ov8gr46v932pdl98vnjd3r7"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": "https://sportiner.com"
      },
      "eas": {
        "projectId": "3fc54ed7-2c43-46b8-b461-2d9d5c2804e6"
      },
      "supportUrl": "https://sportiner.com/support",
      "supportEmail": "support@sportiner.com"
    }
  }
}
