{
  "expo": {
    "name": "Sportiner",
    "slug": "sportiner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sportiner",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.sportiner.app",
      "usesAppleSignIn": true,
      "buildNumber": "58",
      "simulator": {
        "device": "iPhone 17 Pro"
      },
      "supportsTablet": false,
      "appleTeamId": "6YMBF7XTQC"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sportiner.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sportiner uses your location to suggest nearby tennis courts."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Sportiner to read your calendar so it can display your upcoming sports games, practices, and scheduled events inside the app.",
  "calendarFullAccessPermission": "Allow Sportiner to create, update, and delete calendar events so it can automatically schedule, adjust, and manage your games, training sessions, and match times.",
  "remindersPermission": "Allow Sportiner to read your reminders so it can show your existing sports-related tasks and upcoming alerts within the app.",
  "remindersFullAccessPermission": "Allow Sportiner to create, modify, and remove reminders so it can automatically set alerts for games, practices, and event notifications."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.939148334598-8al463kq6ov8gr46v932pdl98vnjd3r7"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3fc54ed7-2c43-46b8-b461-2d9d5c2804e6"
      }
    }
  }
}
